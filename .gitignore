# =============================================================================
# New vulnerability folders named NN-slug are allowed automatically.
# =============================================================================

# 1) Ignore every top-level entry
/*

# 2) Allow the published top-level files
!/.gitignore
!/README.md

# 3) Allow the published top-level folders
!/img/

# 4) Allow every vulnerability folder (two-digit prefix); new labs auto-included
!/[0-9][0-9]-*/

# 5) Re-ignore build/runtime/OS junk anywhere inside the allowed folders
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
flag.txt
*.sqlite
*.sqlite3
#*.db
.env
*.pid
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
CHECKLIST.md
diagram.drawio